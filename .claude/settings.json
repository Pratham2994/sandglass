{
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git log:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)"
    ]
  }
}
